{
  "expo": {
    "name": "FIYDOC",
    "slug": "fiydoc",
    "version": "2.1.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "fiydoc",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.fiydoc.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSLocationWhenInUseUsageDescription": "FiYDoc needs your location to find nearby verified clinics and doctors and estimate travel distance.",
        "NSPhotoLibraryUsageDescription": "FiYDoc needs access to your photos so you can attach clinical images and choose a profile picture.",
        "NSCameraUsageDescription": "FiYDoc needs camera access so you can capture clinical documents and images."
      }
    },
    "android": {
      "package": "com.fiydoc.app",
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#FAF8FF",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.CAMERA"
      ]
    },
    "updates": {
      "url": "https://u.expo.dev/24aa4a10-9492-4cf0-842b-efdd9d32804d",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "runtimeVersion": "1.0.0",
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FAF8FF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      "expo-font",
      "expo-image",
      [
        "expo-image-picker",
        {
          "photosPermission": "FiYDoc needs access to your photos so you can attach clinical images and choose a profile picture.",
          "cameraPermission": "FiYDoc needs camera access so you can capture clinical documents and images."
        }
      ],
      "expo-updates",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "FiYDoc needs your location to find nearby verified clinics and doctors and estimate travel distance."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "minSdkVersion": 24,
            "buildToolsVersion": "36.0.0",
            "extraGradleProperties": {
              "android.suppressUnsupportedCompileSdk": "36",
              "org.gradle.jvmargs": "-Xmx4096m -XX:MaxMetaspaceSize=1024m -XX:+UseParallelGC",
              "org.gradle.parallel": "true",
              "org.gradle.caching": "true"
            }
          },
          "ios": {
            "deploymentTarget": "16.4"
          }
        }
      ],
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "24aa4a10-9492-4cf0-842b-efdd9d32804d"
      }
    },
    "owner": "ronit009"
  }
}
