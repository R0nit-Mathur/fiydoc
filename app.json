{
  "expo": {
    "name": "FiYDoc",
    "slug": "fiydoc",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/app logo.png",
    "scheme": "fiydoc",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.fiydoc.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSLocationWhenInUseUsageDescription": "FiYDoc needs your location to find nearby verified clinics and doctors and estimate travel distance."
      }
    },
    "android": {
      "package": "com.fiydoc.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ]
    },
    "updates": {
      "url": "https://u.expo.dev/91ac7506-c40e-4881-81bc-340db99e2714"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#00B39B",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-font",
      "expo-image",
      "expo-updates",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "FiYDoc needs your location to find nearby verified clinics and doctors and estimate travel distance."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "91ac7506-c40e-4881-81bc-340db99e2714"
      }
    }
  }
}
